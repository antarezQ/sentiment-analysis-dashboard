# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
venv/
env/
ENV/
.venv/

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb_checkpoints/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Environment variables (API keys, secrets!)
.env
.env.local
*.env

# Data - JANGAN commit dataset gede ke GitHub (limit 100MB/file)
data/raw/*.csv
data/raw/*.json
data/raw/*.parquet
data/processed/*.csv
data/processed/*.parquet
!data/raw/.gitkeep
!data/processed/.gitkeep
# Slim table (no user names or locations) that the deployed dashboard reads (see scripts/build_dashboard_data.py)
!data/processed/dashboard_data.csv

# Models - file model gede di-block by default
models/*.h5
models/*.pt
models/*.bin
!models/.gitkeep
# Allow specific trained models (untuk deployment)
!models/*.pkl

# Logs
*.log
logs/

# Streamlit
.streamlit/secrets.toml

# OS
Thumbs.db
